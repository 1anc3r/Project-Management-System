# =====================================================
# 企业项目全生命周期管理系统 - 环境配置
# =====================================================

# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=project_management

# JWT配置
# 安全要求：
#   1. 必须与 DB_PASSWORD 使用【不同】的强随机值（口令复用会导致数据库泄露时 JWT 可被伪造）
#   2. 长度不少于 32 字符，生成方式：openssl rand -base64 48
#   3. 生产环境（NODE_ENV=production）若缺失、过短、命中弱密钥或与 DB_PASSWORD 相同，服务将拒绝启动
JWT_SECRET=replace_with_openssl_rand_base64_48_output
JWT_EXPIRES_IN=24h

# 文件上传配置
UPLOAD_PATH=uploads
MAX_FILE_SIZE=52428800

# 默认管理员账号
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
